{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "3D Model Gallery Manifest",
  "description": "OKÜ Dijital Yerleşke model manifesti. v2, v1'in üzerine yalnızca ISTEĞE BAĞLI bina bilgi alanları ekler; v1 manifestleri geçerli kalır.",
  "type": "object",
  "required": ["version", "models"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1, "maximum": 2 },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "label", "emoji", "model"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "emoji": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "fallback": { "type": "string" },
          "geometryLod": { "type": "string" },
          "type": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "ios": { "type": "string" },
          "poster": { "type": "string" },
          "orbit": { "type": "string" },
          "exposure": { "type": ["number", "string"] },
          "keywords": { "type": "array", "items": { "type": "string" } },

          "officialName": {
            "description": "Kurumun kullandığı resmî bina adı (kart/başlık kısa adı ayrı kalır).",
            "type": "string",
            "minLength": 1
          },
          "category": {
            "description": "Keşif filtreleri ve harita için bina sınıfı.",
            "enum": ["egitim", "yonetim", "sosyal", "uygulama", "plan"]
          },
          "campusZone": {
            "description": "Yerleşke içi bölge adı (ör. merkez, kuzey, uygulama alanı).",
            "type": "string",
            "minLength": 1
          },
          "geo": {
            "description": "Bina girişinin koordinatı. Yol tarifi bağlantısı bu alan varsa gösterilir.",
            "type": "object",
            "additionalProperties": false,
            "required": ["lat", "lng"],
            "properties": {
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lng": { "type": "number", "minimum": -180, "maximum": 180 },
              "heading": { "type": "number", "minimum": 0, "maximum": 360 }
            }
          },
          "facts": {
            "description": "Kurumdan teyitli bina bilgileri. Teyit edilmeyen alan yazılmaz.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "floors": { "type": "integer", "minimum": 0, "maximum": 100 },
              "grossArea_m2": { "type": "number", "exclusiveMinimum": 0 },
              "builtYear": { "type": "integer", "minimum": 1900, "maximum": 2100 },
              "capacity": { "type": "integer", "minimum": 0 }
            }
          },
          "units": {
            "description": "Binada bulunan birimler/bölümler.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "pattern": "^https?://" }
              }
            }
          },
          "accessibility": {
            "description": "Erişilebilirlik donanımı. Alan yoksa arayüzde 'bilgi yok' gösterilir.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "elevator": { "type": "boolean" },
              "ramp": { "type": "boolean" },
              "accessibleWc": { "type": "boolean" },
              "note": { "type": "string", "minLength": 1 }
            }
          },
          "hotspots": {
            "description": "Model üzerinde etiketli noktalar. Konumlar görüntüleyicinin ?edit=hotspot modunda tıklanarak üretilir.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "position"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
                "label": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "position": {
                  "description": "\"x y z\" biçiminde model uzayı konumu.",
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?m? -?\\d+(\\.\\d+)?m? -?\\d+(\\.\\d+)?m?$"
                },
                "normal": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)? -?\\d+(\\.\\d+)? -?\\d+(\\.\\d+)?$"
                }
              }
            }
          },
          "render": {
            "description": "Model başına sahne ayarı. Belirtilmeyen alan varsayılanı kullanır.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "exposure": { "type": "number", "minimum": 0, "maximum": 2 },
              "shadowIntensity": { "type": "number", "minimum": 0, "maximum": 1 },
              "shadowSoftness": { "type": "number", "minimum": 0, "maximum": 1 },
              "environment": {
                "description": "'neutral', 'legacy' veya assets/env altındaki bir .hdr dosyası.",
                "type": "string",
                "pattern": "^(neutral|legacy|assets/env/[A-Za-z0-9._-]+\\.hdr)$"
              }
            }
          },
          "scan": {
            "description": "Model künyesi. Üçgen sayısı ve kademe boyutları build sırasında geometri LOD manifestinden türetilir; buraya yazılmaz.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "method": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "metersPerUnit": {
                "description": "1 model birimi kaç metredir. Fotogrametri çıktıları genellikle ölçeksizdir; bu alan tanımlanmadan ölçüm aracı gerçek mesafe göstermez.",
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  }
}
